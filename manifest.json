{
  "manifest_version": 3,
  "name": "Adobe Connect Dark Mode",
  "version": "1.0.0",
  "description": "Professional Dark Mode for Adobe Connect Web - حالت تاریک پیشرفته برای ادوبی کانکت وب",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Adobe Connect Dark Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content/theme-engine.js",
        "content/observer.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*.css",
        "icons/*.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
